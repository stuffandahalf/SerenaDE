From 52e2bc6cf57308a36f350450a9bb6f4f5f20473b Mon Sep 17 00:00:00 2001
From: Gregory Norton <gregory@serenade.local>
Date: Wed, 16 Sep 2026 01:59:48 -0400
Subject: [PATCH 2/6] Services: Skip service-side IPC codegen in the Lagom
 build

The endpoint headers for these services are already generated by the
Lagom root (LibImageDecoderClient, LibProtocol/LibWeb, LibWebView and
LibSQL need them), so compiling the .ipc files again here would create
duplicate codegen targets. Keep the generation where SerenityOS builds
the service standalone.
---
 Userland/Services/ImageDecoder/CMakeLists.txt  |  9 +++++++--
 Userland/Services/RequestServer/CMakeLists.txt |  9 +++++++--
 Userland/Services/SQLServer/CMakeLists.txt     |  9 +++++++--
 Userland/Services/WebContent/CMakeLists.txt    | 13 +++++++++----
 4 files changed, 30 insertions(+), 10 deletions(-)

diff --git a/Userland/Services/ImageDecoder/CMakeLists.txt b/Userland/Services/ImageDecoder/CMakeLists.txt
index c7c74a701a..e3354353da 100644
--- a/Userland/Services/ImageDecoder/CMakeLists.txt
+++ b/Userland/Services/ImageDecoder/CMakeLists.txt
@@ -3,8 +3,13 @@ serenity_component(
     TARGETS ImageDecoder
 )
 
-compile_ipc(ImageDecoderServer.ipc ImageDecoderServerEndpoint.h)
-compile_ipc(ImageDecoderClient.ipc ImageDecoderClientEndpoint.h)
+# On host systems the endpoint headers are generated by LibImageDecoderClient,
+# which is built as part of Lagom; generating them here too would create
+# duplicate codegen targets.
+if (SERENITYOS)
+    compile_ipc(ImageDecoderServer.ipc ImageDecoderServerEndpoint.h)
+    compile_ipc(ImageDecoderClient.ipc ImageDecoderClientEndpoint.h)
+endif()
 
 set(SOURCES
     ConnectionFromClient.cpp
diff --git a/Userland/Services/RequestServer/CMakeLists.txt b/Userland/Services/RequestServer/CMakeLists.txt
index 34c533c18c..4aa67106c5 100644
--- a/Userland/Services/RequestServer/CMakeLists.txt
+++ b/Userland/Services/RequestServer/CMakeLists.txt
@@ -3,8 +3,13 @@ serenity_component(
     TARGETS RequestServer
 )
 
-compile_ipc(RequestServer.ipc RequestServerEndpoint.h)
-compile_ipc(RequestClient.ipc RequestClientEndpoint.h)
+# On host systems the endpoint headers are generated by the Lagom build itself
+# (needed by LibWeb and LibProtocol); generating them here too would create
+# duplicate codegen targets.
+if (SERENITYOS)
+    compile_ipc(RequestServer.ipc RequestServerEndpoint.h)
+    compile_ipc(RequestClient.ipc RequestClientEndpoint.h)
+endif()
 
 set(SOURCES
     ConnectionFromClient.cpp
diff --git a/Userland/Services/SQLServer/CMakeLists.txt b/Userland/Services/SQLServer/CMakeLists.txt
index 7af579d07e..d7c318e6b5 100644
--- a/Userland/Services/SQLServer/CMakeLists.txt
+++ b/Userland/Services/SQLServer/CMakeLists.txt
@@ -4,8 +4,13 @@ serenity_component(
     TARGETS SQLServer
 )
 
-compile_ipc(SQLServer.ipc SQLServerEndpoint.h)
-compile_ipc(SQLClient.ipc SQLClientEndpoint.h)
+# On host systems the endpoint headers are generated by LibSQL, which is built
+# as part of Lagom; generating them here too would create duplicate codegen
+# targets.
+if (SERENITYOS)
+    compile_ipc(SQLServer.ipc SQLServerEndpoint.h)
+    compile_ipc(SQLClient.ipc SQLClientEndpoint.h)
+endif()
 
 set(SOURCES
     ConnectionFromClient.cpp
diff --git a/Userland/Services/WebContent/CMakeLists.txt b/Userland/Services/WebContent/CMakeLists.txt
index 226bfa8f52..cc2f62835f 100644
--- a/Userland/Services/WebContent/CMakeLists.txt
+++ b/Userland/Services/WebContent/CMakeLists.txt
@@ -6,11 +6,16 @@ serenity_component(
     DEPENDS ImageDecoder RequestServer
 )
 
-compile_ipc(WebContentServer.ipc WebContentServerEndpoint.h)
-compile_ipc(WebContentClient.ipc WebContentClientEndpoint.h)
+# On host systems the endpoint headers are generated by the Lagom build itself
+# (needed by LibWebView); generating them here too would create duplicate
+# codegen targets.
+if (SERENITYOS)
+    compile_ipc(WebContentServer.ipc WebContentServerEndpoint.h)
+    compile_ipc(WebContentClient.ipc WebContentClientEndpoint.h)
 
-compile_ipc(WebDriverClient.ipc WebDriverClientEndpoint.h)
-compile_ipc(WebDriverServer.ipc WebDriverServerEndpoint.h)
+    compile_ipc(WebDriverClient.ipc WebDriverClientEndpoint.h)
+    compile_ipc(WebDriverServer.ipc WebDriverServerEndpoint.h)
+endif()
 
 set(SOURCES
     ConnectionFromClient.cpp
-- 
2.55.0

