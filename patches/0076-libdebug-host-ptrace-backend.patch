         ++vm_entry_index;
         if (m_on_initialization_progress)
@@ -485,28 +643,42 @@ ErrorOr<void> DebugSession::update_loaded_libs()
         if (!object_path.has_value())
             return IterationDecision::Continue;
 
-        ByteString lib_name = object_path.value();
-        if (FileSystem::looks_like_shared_library(lib_name))
-            lib_name = LexicalPath::basename(object_path.value());
+        add_object(object_path.value(), entry.as_object().get_addr("address"sv).value_or(0));
+        return IterationDecision::Continue;
+    });
+#else
+    // Host systems expose the address space as the classic text maps format:
+    //   <start>-<end> <perms> <offset> <major:minor> <inode> [path]
+    auto file_name = TRY(String::formatted("/proc/{}/maps", m_debuggee_pid));
+    auto file = TRY(Core::File::open(file_name, Core::File::OpenMode::Read));
 
-        FlatPtr base_address = entry.as_object().get_addr("address"sv).value_or(0);
-        if (auto it = m_loaded_libraries.find(lib_name); it != m_loaded_libraries.end()) {
-            // We expect the VM regions to be sorted by address.
-            VERIFY(base_address >= it->value->base_address);
-            return IterationDecision::Continue;
-        }
+    auto file_contents = TRY(file->read_until_eof());
+    StringView contents { file_contents };
+    auto lines = contents.split_view('\n');
 
-        auto file_or_error = Core::MappedFile::map(object_path.value());
-        if (file_or_error.is_error())
-            return IterationDecision::Continue;
+    size_t line_index = 0;
+    for (auto const& line : lines) {
+        ++line_index;
+        if (m_on_initialization_progress)
+            m_on_initialization_progress(line_index / static_cast<float>(lines.size()));
 
-        auto image = make<ELF::Image>(file_or_error.value()->bytes());
-        auto debug_info = make<DebugInfo>(*image, m_source_root, base_address);
-        auto lib = make<LoadedLibrary>(lib_name, file_or_error.release_value(), move(image), move(debug_info), base_address);
-        m_loaded_libraries.set(lib_name, move(lib));
+        auto parts = line.split_view(' ');
+        if (parts.size() < 6)
+            continue; // anonymous mapping, no backing file
 
-        return IterationDecision::Continue;
-    });
+        auto const& range = parts[0];
+        auto dash_index = range.find('-');
+        if (!dash_index.has_value())
+            continue;
+        FlatPtr base_address = range.substring_view(0, *dash_index).to_number<FlatPtr>().value_or(0);
+
+        auto path = parts[5].to_byte_string();
+        if (path.starts_with('[')) // [stack], [heap], ...
+            continue;
+
+        add_object(move(path), base_address);
+    }
+#endif
 
     return {};
