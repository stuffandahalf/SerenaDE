+// Serenity's ptrace request names do not exist on host systems; map them to
+// the equivalent PTRACE_* requests. The debug-register requests (used for
+// watchpoints) have no host counterpart and are gated out below.
+#    define PT_DETACH PTRACE_DETACH
+#    define PT_TRACE_ME PTRACE_TRACEME
+#    define PT_ATTACH PTRACE_ATTACH
+#    define PT_PEEK PTRACE_PEEKDATA
+#    define PT_POKE PTRACE_POKEDATA
+#    define PT_CONTINUE PTRACE_CONT
+#    define PT_SYSCALL PTRACE_SYSCALL
+#    define PT_SINGLESTEP PTRACE_SINGLESTEP
+#    define PT_GETREGS PTRACE_GETREGS
+#    define PT_SETREGS PTRACE_SETREGS
+#endif
+
 namespace Debug {
 
 DebugSession::DebugSession(pid_t pid, ByteString source_root, Function<void(float)> on_initialization_progress)
@@ -101,6 +122,7 @@ OwnPtr<DebugSession> DebugSession::exec_and_attach(ByteString const& command,
         return {};
     }
 
