         perror("wait_pid");
         return {};
     }
+#else
+    // On Linux the child is already traced via PT_TRACE_ME, so PT_ATTACH would
+    // fail with EPERM; the wait above has already caught the execve stop and the
+    // debuggee is stopped at the entry point of the target image.
+#endif
 
     auto debug_session = adopt_own(*new DebugSession(pid, source_root, move(on_initialization_progress)));
 
