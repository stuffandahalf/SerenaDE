 PtraceRegisters DebugSession::get_registers() const
 {
-    PtraceRegisters regs;
+    PtraceRegisters regs {};
+#ifdef AK_OS_SERENITY
     if (ptrace(PT_GETREGS, m_debuggee_pid, &regs, 0) < 0) {
         perror("PT_GETREGS");
         VERIFY_NOT_REACHED();
     }
+#else
+    // Copy field by field rather than bit-casting: glibc's user_regs_struct is
+    // not laid out like Serenity's __mcontext.
+    struct user_regs_struct host_regs {};
+    if (ptrace(PT_GETREGS, m_debuggee_pid, nullptr, &host_regs) < 0) {
+        perror("PT_GETREGS");
+        VERIFY_NOT_REACHED();
+    }
+    regs.rax = host_regs.rax;
+    regs.rcx = host_regs.rcx;
+    regs.rdx = host_regs.rdx;
+    regs.rbx = host_regs.rbx;
+    regs.rsp = host_regs.rsp;
+    regs.rbp = host_regs.rbp;
+    regs.rsi = host_regs.rsi;
+    regs.rdi = host_regs.rdi;
+    regs.rip = host_regs.rip;
+    regs.r8 = host_regs.r8;
+    regs.r9 = host_regs.r9;
+    regs.r10 = host_regs.r10;
+    regs.r11 = host_regs.r11;
+    regs.r12 = host_regs.r12;
+    regs.r13 = host_regs.r13;
+    regs.r14 = host_regs.r14;
+    regs.r15 = host_regs.r15;
+    regs.rflags = host_regs.eflags;
+    regs.cs = host_regs.cs;
+    regs.ss = host_regs.ss;
+    regs.ds = host_regs.ds;
+    regs.es = host_regs.es;
+    regs.fs = host_regs.fs;
+    regs.gs = host_regs.gs;
+#endif
     return regs;
 }
 
 void DebugSession::set_registers(PtraceRegisters const& regs)
 {
+#ifdef AK_OS_SERENITY
     if (ptrace(PT_SETREGS, m_debuggee_pid, bit_cast<void*>(&regs), 0) < 0) {
         perror("PT_SETREGS");
         VERIFY_NOT_REACHED();
     }
+#else
+    struct user_regs_struct host_regs {};
+    host_regs.rax = regs.rax;
+    host_regs.rcx = regs.rcx;
+    host_regs.rdx = regs.rdx;
+    host_regs.rbx = regs.rbx;
+    host_regs.rsp = regs.rsp;
+    host_regs.rbp = regs.rbp;
+    host_regs.rsi = regs.rsi;
+    host_regs.rdi = regs.rdi;
+    host_regs.rip = regs.rip;
+    host_regs.r8 = regs.r8;
+    host_regs.r9 = regs.r9;
+    host_regs.r10 = regs.r10;
+    host_regs.r11 = regs.r11;
+    host_regs.r12 = regs.r12;
+    host_regs.r13 = regs.r13;
+    host_regs.r14 = regs.r14;
+    host_regs.r15 = regs.r15;
+    host_regs.eflags = regs.rflags;
+    host_regs.cs = regs.cs;
+    host_regs.ss = regs.ss;
+    host_regs.ds = regs.ds;
+    host_regs.es = regs.es;
+    host_regs.fs = regs.fs;
+    host_regs.gs = regs.gs;
+    if (ptrace(PT_SETREGS, m_debuggee_pid, nullptr, &host_regs) < 0) {
+        perror("PT_SETREGS");
+        VERIFY_NOT_REACHED();
+    }
+#endif
 }
 
