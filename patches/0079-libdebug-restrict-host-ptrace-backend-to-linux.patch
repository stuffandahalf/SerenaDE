From a696f9b6d69dc6b24471dabb8649735703712044 Mon Sep 17 00:00:00 2001
From: Gregory Norton <gregory.norton@me.com>
Date: Fri, 9 Oct 2026 18:23:09 -0400
Subject: [PATCH] LibDebug: Restrict the host ptrace backend to Linux

BSDs have ptrace but with different request semantics and register structs
(FreeBSD's struct reg vs glibc's user_regs_struct), and no /proc maps view.
Gate the host DebugSession implementation behind AK_OS_LINUX so LibDebug,
Debugger and CrashReporter still compile on FreeBSD/NetBSD/OpenBSD, with
graceful stubs (attach returns nothing) elsewhere.

The attach() body and set_registers() are fully guarded so the file also
compiles under -Werror on hosts where the PT_* request names do not exist.
---
 Userland/Libraries/LibDebug/DebugSession.cpp | 72 ++++++++++++++++++--
 1 file changed, 65 insertions(+), 7 deletions(-)

diff --git a/Userland/Libraries/LibDebug/DebugSession.cpp b/Userland/Libraries/LibDebug/DebugSession.cpp
index 30732a08da..23ed371c9f 100644
--- a/Userland/Libraries/LibDebug/DebugSession.cpp
+++ b/Userland/Libraries/LibDebug/DebugSession.cpp
@@ -18,7 +18,7 @@
 
 #ifdef AK_OS_SERENITY
 #    include <sys/ptrace.h>
-#else
+#elif defined(AK_OS_LINUX)
 #    include <sys/ptrace.h>
 #    include <sys/user.h>
 
@@ -61,9 +61,11 @@ DebugSession::~DebugSession()
     }
     m_watchpoints.clear();
 
+#if defined(AK_OS_SERENITY) || defined(AK_OS_LINUX)
     if (ptrace(PT_DETACH, m_debuggee_pid, 0, 0) < 0) {
         perror("PT_DETACH");
     }
+#endif
 }
 
 void DebugSession::for_each_loaded_library(Function<IterationDecision(LoadedLibrary const&)> func) const
@@ -80,6 +82,17 @@ OwnPtr<DebugSession> DebugSession::exec_and_attach(ByteString const& command,
     Function<ErrorOr<void>()> setup_child,
     Function<void(float)> on_initialization_progress)
 {
+#if !defined(AK_OS_SERENITY) && !defined(AK_OS_LINUX)
+    // BSD ptrace differs from the Linux/Serenity interface (different request
+    // semantics and register structs); a BSD backend is future work.
+    dbgln("DebugSession: ptrace-based debugging is currently implemented for Serenity and Linux hosts only.");
+    (void)command;
+    (void)source_root;
+    (void)setup_child;
+    (void)on_initialization_progress;
+    return {};
+#endif
+
     auto pid = fork();
 
     if (pid < 0) {
@@ -96,10 +109,12 @@ OwnPtr<DebugSession> DebugSession::exec_and_attach(ByteString const& command,
             }
         }
 
+#if defined(AK_OS_SERENITY) || defined(AK_OS_LINUX)
         if (ptrace(PT_TRACE_ME, 0, 0, 0) < 0) {
             perror("PT_TRACE_ME");
             exit(1);
         }
+#endif
 
         auto parts = command.split(' ');
         VERIFY(!parts.is_empty());
@@ -164,21 +179,31 @@ OwnPtr<DebugSession> DebugSession::exec_and_attach(ByteString const& command,
 
 OwnPtr<DebugSession> DebugSession::attach(pid_t pid, ByteString source_root, Function<void(float)> on_initialization_progress)
 {
+#if !defined(AK_OS_SERENITY) && !defined(AK_OS_LINUX)
+    dbgln("DebugSession: ptrace-based debugging is currently implemented for Serenity and Linux hosts only.");
+    (void)pid;
+    (void)source_root;
+    (void)on_initialization_progress;
+    return {};
+#endif
+
+#if defined(AK_OS_SERENITY) || defined(AK_OS_LINUX)
     if (ptrace(PT_ATTACH, pid, 0, 0) < 0) {
         perror("PT_ATTACH");
         return {};
     }
 
     int status = 0;
-#ifdef AK_OS_SERENITY
+#  ifdef AK_OS_SERENITY
     if (waitpid(pid, &status, WSTOPPED | WEXITED) != pid || !WIFSTOPPED(status)) {
-#else
+#  else
     // glibc's waitpid does not accept the BSD-style WEXITED flag.
     if (waitpid(pid, &status, WSTOPPED) != pid || !WIFSTOPPED(status)) {
-#endif
+#  endif
         perror("waitpid");
         return {};
     }
+#endif
 
     auto debug_session = adopt_own(*new DebugSession(pid, source_root, move(on_initialization_progress)));
     // At this point, libraries should have been loaded
@@ -193,20 +218,31 @@ OwnPtr<DebugSession> DebugSession::attach(pid_t pid, ByteString source_root, Fun
 
 bool DebugSession::poke(FlatPtr address, FlatPtr data)
 {
+#if defined(AK_OS_SERENITY) || defined(AK_OS_LINUX)
     if (ptrace(PT_POKE, m_debuggee_pid, bit_cast<void*>(address), bit_cast<void*>(data)) < 0) {
         perror("PT_POKE");
         return false;
     }
     return true;
+#else
+    (void)address;
+    (void)data;
+    return false;
+#endif
 }
 
 Optional<FlatPtr> DebugSession::peek(FlatPtr address) const
 {
+#if defined(AK_OS_SERENITY) || defined(AK_OS_LINUX)
     Optional<FlatPtr> result;
     auto rc = ptrace(PT_PEEK, m_debuggee_pid, bit_cast<void*>(address), nullptr);
     if (errno == 0)
         result = static_cast<FlatPtr>(rc);
     return result;
+#else
+    (void)address;
+    return {};
+#endif
 }
 
 bool DebugSession::poke_debug(u32 register_index, FlatPtr data) const
@@ -389,7 +425,7 @@ PtraceRegisters DebugSession::get_registers() const
         perror("PT_GETREGS");
         VERIFY_NOT_REACHED();
     }
-#else
+#elif defined(AK_OS_LINUX)
     // Copy field by field rather than bit-casting: glibc's user_regs_struct is
     // not laid out like Serenity's __mcontext.
     struct user_regs_struct host_regs {};
@@ -427,12 +463,15 @@ PtraceRegisters DebugSession::get_registers() const
 
 void DebugSession::set_registers(PtraceRegisters const& regs)
 {
+#if !defined(AK_OS_SERENITY) && !defined(AK_OS_LINUX)
+    (void)regs; // No backend: registers are never set on this host.
+#endif
 #ifdef AK_OS_SERENITY
     if (ptrace(PT_SETREGS, m_debuggee_pid, bit_cast<void*>(&regs), 0) < 0) {
         perror("PT_SETREGS");
         VERIFY_NOT_REACHED();
     }
-#else
+#elif defined(AK_OS_LINUX)
     struct user_regs_struct host_regs {};
     host_regs.rax = regs.rax;
     host_regs.rcx = regs.rcx;
@@ -467,15 +506,20 @@ void DebugSession::set_registers(PtraceRegisters const& regs)
 
 void DebugSession::continue_debuggee(ContinueType type)
 {
+#if defined(AK_OS_SERENITY) || defined(AK_OS_LINUX)
     auto command = (type == ContinueType::FreeRun) ? PT_CONTINUE : PT_SYSCALL;
     if (ptrace(command, m_debuggee_pid, 0, 0) < 0) {
         perror("continue");
         VERIFY_NOT_REACHED();
     }
+#else
+    (void)type;
+#endif
 }
 
 int DebugSession::continue_debuggee_and_wait(ContinueType type)
 {
+#if defined(AK_OS_SERENITY) || defined(AK_OS_LINUX)
     continue_debuggee(type);
     int wstatus = 0;
 #ifdef AK_OS_SERENITY
@@ -489,10 +533,16 @@ int DebugSession::continue_debuggee_and_wait(ContinueType type)
         VERIFY_NOT_REACHED();
     }
     return wstatus;
+#else
+    // A DebugSession can only exist on platforms with a ptrace backend.
+    (void)type;
+    return 0;
+#endif
 }
 
 FlatPtr DebugSession::single_step()
 {
+#if defined(AK_OS_SERENITY) || defined(AK_OS_LINUX)
     if (ptrace(PT_SINGLESTEP, m_debuggee_pid, 0, 0) < 0) {
         perror("PT_SINGLESTEP");
         VERIFY_NOT_REACHED();
@@ -518,7 +568,11 @@ FlatPtr DebugSession::single_step()
 #else
 #    error Unknown architecture
 #endif
+
     return regs.ip();
+#else
+    return 0;
+#endif
 }
 
 void DebugSession::detach()
@@ -646,7 +700,7 @@ ErrorOr<void> DebugSession::update_loaded_libs()
         add_object(object_path.value(), entry.as_object().get_addr("address"sv).value_or(0));
         return IterationDecision::Continue;
     });
-#else
+#elif defined(AK_OS_LINUX)
     // Host systems expose the address space as the classic text maps format:
     //   <start>-<end> <perms> <offset> <major:minor> <inode> [path]
     auto file_name = TRY(String::formatted("/proc/{}/maps", m_debuggee_pid));
@@ -678,6 +732,10 @@ ErrorOr<void> DebugSession::update_loaded_libs()
 
         add_object(move(path), base_address);
     }
+#else
+    // BSD hosts expose no /proc address-space view; the ptrace backend is
+    // Linux-only for now, so there are no libraries to enumerate.
+    (void)add_object;
 #endif
 
     return {};
-- 
2.56.0

