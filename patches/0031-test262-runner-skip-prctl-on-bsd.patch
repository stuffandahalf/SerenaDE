From 52e67429ac83e47950a4fa2092fd30d6726aa27c Mon Sep 17 00:00:00 2001
From: Gregory Norton <gregory@serenade.local>
Date: Fri, 06 Sep 2026 00:00:00 +0000
Subject: [PATCH 31/31] LibJS test runner: Skip prctl in test262-runner on BSDs

test262-runner.cpp has the same unguarded-for-BSD prctl pattern as CrashTest.cpp (patch 0030):
it includes <sys/prctl.h> and calls prctl(PR_SET_DUMPABLE, ...) on every host except
macOS/Emscripten/Hurd. prctl is Linux/Serenity-only and absent on FreeBSD, so it fails to
compile there. Add AK_OS_BSD_GENERIC to both guards; BSDs simply skip disabling core dumps.
Linux/Serenity behavior is unchanged.

diff --git a/Tests/LibJS/test262-runner.cpp b/Tests/LibJS/test262-runner.cpp
index e49e4f12..2611e733 100644
@@ -28,7 +28,7 @@
 #include <signal.h>
 #include <unistd.h>
 
-#if !defined(AK_OS_MACOS) && !defined(AK_OS_EMSCRIPTEN) && !defined(AK_OS_GNU_HURD)
+#if !defined(AK_OS_MACOS) && !defined(AK_OS_EMSCRIPTEN) && !defined(AK_OS_GNU_HURD) && !defined(AK_OS_BSD_GENERIC)
 // Only used to disable core dumps
 #    include <sys/prctl.h>
 #endif
@@ -589,7 +589,8 @@
 #ifdef AK_OS_GNU_HURD
     if (disable_core_dumping)
         setenv("CRASHSERVER", "/servers/crash-kill", true);
-#elif !defined(AK_OS_MACOS) && !defined(AK_OS_EMSCRIPTEN)
+#elif !defined(AK_OS_MACOS) && !defined(AK_OS_EMSCRIPTEN) && !defined(AK_OS_BSD_GENERIC)
+    // prctl() is Linux/Serenity-only (BSDs have no equivalent); skip disabling core dumps there.
     if (disable_core_dumping && prctl(PR_SET_DUMPABLE, 0, 0, 0) < 0) {
         perror("prctl(PR_SET_DUMPABLE)");
         return exit_wrong_arguments;
