From 4cd36e9f7b0b729a13f105f6628dd9eac20dcda4 Mon Sep 17 00:00:00 2001
From: Gregory Norton <gregory.norton@me.com>
Date: Fri, 18 Sep 2026 20:06:47 -0400
Subject: [PATCH 11/11] Run: Use a fixed history-line buffer size

PAGE_SIZE is not a constant expression on host systems (glibc defines it
via sysconf()), so it cannot be a template argument. History lines are
paths; 4 KiB is plenty.
---
 Userland/Applications/Run/RunWindow.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Userland/Applications/Run/RunWindow.cpp b/Userland/Applications/Run/RunWindow.cpp
index 4263f540ba..60a30bc409 100644
--- a/Userland/Applications/Run/RunWindow.cpp
+++ b/Userland/Applications/Run/RunWindow.cpp
@@ -194,7 +194,9 @@ ErrorOr<void> RunWindow::load_history()
     m_path_history.clear();
     auto file = TRY(Core::File::open(history_file_path(), Core::File::OpenMode::Read));
     auto buffered_file = TRY(Core::InputBufferedFile::create(move(file)));
-    Array<u8, PAGE_SIZE> line_buffer;
+    // History lines are paths; 4 KiB is plenty and works as a template argument
+    // on host systems where PAGE_SIZE is not a constant expression.
+    Array<u8, 4096> line_buffer;
 
     while (!buffered_file->is_eof()) {
         StringView line = TRY(buffered_file->read_line(line_buffer));
-- 
