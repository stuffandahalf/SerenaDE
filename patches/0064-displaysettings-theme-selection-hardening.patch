From 329393962dd39a0cdfe3eb42bd828397afac6c29 Mon Sep 17 00:00:00 2001
From: Gregory Norton <gregory.norton@me.com>
Date: Fri, 18 Sep 2026 20:06:47 -0400
Subject: [PATCH 08/11] DisplaySettings: Harden theme selection against missing
 themes

current_theme_index was left uninitialized when the WindowServer's
configured theme is not among the installed ones (and the WS config on
host sessions may lack a [Theme] entry entirely), crashing in
ComboBox::set_selected_index. Default to the first available theme and
guard the empty-list case.
---
 .../DisplaySettings/ThemesSettingsWidget.cpp  | 23 +++++++++++++------
 1 file changed, 16 insertions(+), 7 deletions(-)

diff --git a/Userland/Applications/DisplaySettings/ThemesSettingsWidget.cpp b/Userland/Applications/DisplaySettings/ThemesSettingsWidget.cpp
index 1652b4f62a..6dddcf9bc7 100644
--- a/Userland/Applications/DisplaySettings/ThemesSettingsWidget.cpp
+++ b/Userland/Applications/DisplaySettings/ThemesSettingsWidget.cpp
@@ -36,7 +36,7 @@ ErrorOr<void> ThemesSettingsWidget::setup_interface()
 {
     m_themes = TRY(Gfx::list_installed_system_themes());
 
-    size_t current_theme_index;
+    size_t current_theme_index { 0 };
     auto current_theme_name = GUI::ConnectionToWindowServer::the().get_system_theme();
     TRY(m_theme_names.try_ensure_capacity(m_themes.size()));
     for (auto& theme_meta : m_themes) {
@@ -46,6 +46,12 @@ ErrorOr<void> ThemesSettingsWidget::setup_interface()
             current_theme_index = m_theme_names.size() - 1;
         }
     }
+    // The WindowServer's configured theme may not be installed (or the config
+    // entry may be missing); fall back to the first available theme.
+    if (!m_selected_theme && !m_themes.is_empty()) {
+        m_selected_theme = &m_themes.first();
+        current_theme_index = 0;
+    }
 
     m_theme_preview = find_descendant_of_type_named<GUI::Frame>("preview_frame")->add<ThemePreviewWidget>(palette());
     m_themes_combo = *find_descendant_of_type_named<GUI::ComboBox>("themes_combo");
@@ -67,7 +73,8 @@ ErrorOr<void> ThemesSettingsWidget::setup_interface()
         }
         set_modified(true);
     };
-    m_themes_combo->set_selected_index(current_theme_index, GUI::AllowCallback::No);
+    if (!m_theme_names.is_empty())
+        m_themes_combo->set_selected_index(current_theme_index, GUI::AllowCallback::No);
 
     auto mouse_settings_icon = TRY(Gfx::Bitmap::load_from_uri("resource://icons/16x16/app-mouse.png"sv));
 
@@ -90,11 +97,13 @@ ErrorOr<void> ThemesSettingsWidget::setup_interface()
         m_color_scheme_is_file_based = false;
     }
 
-    auto theme_config = TRY(Core::ConfigFile::open(m_selected_theme->path));
-    if (!selected_color_scheme_index.has_value() || GUI::Widget::palette().color_scheme_path() != theme_config->read_entry("Paths", "ColorScheme")) {
-        if (m_color_scheme_names.size() > 1) {
-            color_scheme_combo.set_enabled(true);
-            find_descendant_of_type_named<GUI::CheckBox>("custom_color_scheme_checkbox")->set_checked(true);
+    if (m_selected_theme) {
+        auto theme_config = TRY(Core::ConfigFile::open(m_selected_theme->path));
+        if (!selected_color_scheme_index.has_value() || GUI::Widget::palette().color_scheme_path() != theme_config->read_entry("Paths", "ColorScheme")) {
+            if (m_color_scheme_names.size() > 1) {
+                color_scheme_combo.set_enabled(true);
+                find_descendant_of_type_named<GUI::CheckBox>("custom_color_scheme_checkbox")->set_checked(true);
+            }
         }
     }
     color_scheme_combo.on_change = [this](auto&, GUI::ModelIndex const& index) {
-- 
