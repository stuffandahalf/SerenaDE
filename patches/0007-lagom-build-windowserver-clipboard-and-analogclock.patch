index ee0d346bb3..d911a1ebc4 100644
--- a/Userland/Services/CMakeLists.txt
+++ b/Userland/Services/CMakeLists.txt
@@ -1,14 +1,15 @@
+add_subdirectory(Clipboard)
 add_subdirectory(ConfigServer)
 add_subdirectory(EchoServer)
