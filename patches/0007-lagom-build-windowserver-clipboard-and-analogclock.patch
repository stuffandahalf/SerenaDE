From ae671bc9fcbaa3c57130566070e958aa0a6a60ac Mon Sep 17 00:00:00 2001
From: Gregory Norton <gregory@serenade.local>
Date: Sat, 30 Aug 2026 00:00:00 +0000
Subject: [PATCH 7/10] Lagom: Build WindowServer, Clipboard, and AnalogClock on hosts

WindowServer, Clipboard, and the AnalogClock application build
unmodified against the host toolchain once their dependencies are in
place:

- Add Keyboard to the standard library list.
- Enable the ASM language (application icons embed as assembly objects).
- Build WindowServer and Clipboard as regular Lagom services; expose a
  shim sys/devices/gpu.h (host types from GpuTypesHost.h plus the original
  inline ioctl wrappers) so the screen backends compile without putting
  the whole Serenity LibC header tree on the include path.
- Add AnalogClock, the first application built unmodified on hosts.

diff --git a/Meta/Lagom/CMakeLists.txt b/Meta/Lagom/CMakeLists.txt
index cb5fef3c82..94665e42be 100644
--- a/Meta/Lagom/CMakeLists.txt
+++ b/Meta/Lagom/CMakeLists.txt
@@ -5,7 +5,7 @@ project(
     VERSION 0.0.0
     DESCRIPTION "Host build of SerenityOS libraries and applications"
     HOMEPAGE_URL "https://github.com/SerenityOS/serenity"
-    LANGUAGES C CXX
+    LANGUAGES C CXX ASM
 )
 
 if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS "12")
@@ -487,6 +487,7 @@ if (BUILD_LAGOM)
         IPC
         JIT
         JS
+        Keyboard
         Line
         Locale
         Manual
@@ -557,6 +558,9 @@ if (BUILD_LAGOM)
         # Lagom Services
         add_serenity_subdirectory(Userland/Services)
 
+        # Applications that build unmodified on host systems.
+        add_serenity_subdirectory(Userland/Applications/AnalogClock)
+
         # Lagom Utilities
         lagom_utility(abench SOURCES ../../Userland/Utilities/abench.cpp LIBS LibMain LibFileSystem LibAudio)
         lagom_utility(aconv SOURCES ../../Userland/Utilities/aconv.cpp LIBS LibMain LibFileSystem LibAudio)
