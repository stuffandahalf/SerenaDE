     TRY(Core::System::unveil(nullptr, nullptr));
 
+    // Optional headless support (host systems): when WINDOW_SERVER_SCREENSHOT
+    // is set, SIGUSR1 dumps the main screen's front buffer to that path as PNG.
+    // The notifier must outlive loop.exec() below, so keep it in this scope.
+    RefPtr<Core::Notifier> screenshot_notifier;
+    if (auto const* screenshot_path = getenv("WINDOW_SERVER_SCREENSHOT")) {
+        int pipe_fds[2];
+        if (::pipe(pipe_fds) == 0) {
+            ::fcntl(pipe_fds[0], F_SETFL, O_NONBLOCK);
+            ::fcntl(pipe_fds[0], F_SETFD, FD_CLOEXEC);
+            ::fcntl(pipe_fds[1], F_SETFL, O_NONBLOCK);
+            ::fcntl(pipe_fds[1], F_SETFD, FD_CLOEXEC);
+
+            s_screenshot_pipe_write_fd = pipe_fds[1];
+            struct sigaction screenshot_action = {};
+            screenshot_action.sa_handler = [](int) {
+                if (s_screenshot_pipe_write_fd < 0)
+                    return;
+                char c = 's';
+                (void)!::write(s_screenshot_pipe_write_fd, &c, 1);
+            };
+            TRY(Core::System::sigaction(SIGUSR1, &screenshot_action, nullptr));
+
+            screenshot_notifier = Core::Notifier::construct(pipe_fds[0], Core::Notifier::Type::Read);
+            screenshot_notifier->on_activation = [screenshot_path, pipe_fds] {
+                char drain_buffer[64];
+                while (::read(pipe_fds[0], drain_buffer, sizeof(drain_buffer)) > 0)
+                    continue;
+
+                auto bitmap = WindowServer::Screen::main().take_screenshot();
+                auto png_bytes = MUST(Gfx::PNGWriter::encode(*bitmap));
+                auto file_or_error = Core::File::open(ByteString(screenshot_path), Core::File::OpenMode::ReadWrite | Core::File::OpenMode::Truncate);
+                if (!file_or_error.is_error()) {
+                    auto& file = file_or_error.value();
+                    auto const* data = png_bytes.data();
+                    size_t remaining_size = png_bytes.size();
+                    while (remaining_size > 0) {
+                        auto written = MUST(file->write_some({ data, remaining_size }));
+                        data += written;
+                        remaining_size -= written;
+                    }
+                    dbgln("Wrote screenshot to {}", screenshot_path);
+                } else {
+                    dbgln("Failed to open {} for writing the screenshot: {}", screenshot_path, file_or_error.error());
+                }
+            };
+        } else {
+            dbgln("Failed to create the screenshot pipe: {}", ::strerror(errno));
+        }
+    }
+
     dbgln("Entering WindowServer main loop");
     loop.exec();
     VERIFY_NOT_REACHED();
