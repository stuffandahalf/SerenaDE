@@ -89,10 +93,19 @@ void KeymapSwitcher::next_keymap()
 
 ByteString KeymapSwitcher::get_current_keymap() const
 {
-    auto proc_keymap = Core::File::open("/sys/kernel/keymap"sv, Core::File::OpenMode::Read).release_value_but_fixme_should_propagate_errors();
-    auto proc_keymap_data = proc_keymap->read_until_eof().release_value_but_fixme_should_propagate_errors();
-    auto json = JsonValue::from_string(proc_keymap_data).release_value_but_fixme_should_propagate_errors();
-    auto const& keymap_object = json.as_object();
+    // On host systems (Lagom builds) there is no kernel keymap file; callers
+    // treat an empty result as "unknown" and fall back to the first keymap.
+    auto proc_keymap = Core::File::open("/sys/kernel/keymap"sv, Core::File::OpenMode::Read);
+    if (proc_keymap.is_error())
+        return {};
+    auto& keymap_file = proc_keymap.value();
+    auto proc_keymap_data = keymap_file->read_until_eof();
+    if (proc_keymap_data.is_error())
+        return {};
+    auto json = JsonValue::from_string(proc_keymap_data.value());
+    if (json.is_error())
+        return {};
+    auto const& keymap_object = json.value().as_object();
     VERIFY(keymap_object.has_string("keymap"sv));
     return keymap_object.get_byte_string("keymap"sv).value();
 }
diff --git a/Userland/Services/WindowServer/ResourcePath.h b/Userland/Services/WindowServer/ResourcePath.h
new file mode 100644
index 0000000000..e7e4b46fa5
--- /dev/null
+++ b/Userland/Services/WindowServer/ResourcePath.h
@@ -0,0 +1,30 @@
+/*
+ * Copyright (c) 2026, Gregory Norton.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteString.h>
+#include <AK/Format.h>
+#include <AK/StringView.h>
+#include <cstdlib>
+
+namespace WindowServer {
+
+// Root of the Serenity resources: /res on Serenity itself, or the directory
+// pointed to by $SERENITY_RES when running on a host system (Lagom build).
+inline ByteString res_root()
+{
+    if (auto const* root = std::getenv("SERENITY_RES"))
+        return ByteString(root);
+    return "/res"sv;
+}
+
+inline ByteString res_path(StringView relative)
+{
+    return ByteString::formatted("{}/{}", res_root(), relative);
+}
+
+}
