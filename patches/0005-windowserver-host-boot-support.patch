+NonnullRefPtr<Gfx::Bitmap> Screen::take_screenshot() const
+{
+    auto& front_bitmap = m_compositor_screen_data->m_front_bitmap;
+    VERIFY(front_bitmap);
+    auto bitmap = Gfx::Bitmap::create(front_bitmap->format(), front_bitmap->size(), this->scale_factor()).release_value();
+    for (int y = 0; y < front_bitmap->height(); ++y)
+        memcpy(bitmap->scanline_u8(y), front_bitmap->scanline_u8(y), front_bitmap->pitch());
+    return bitmap;
+}
